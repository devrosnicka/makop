# Copy to .env (gitignored) and fill in real values to exercise Google login
# locally. See docs/specs/manager-auth.md and docs/decisions/0003-manager-authentication.md
# for the one-time Google Cloud Console setup (OAuth consent screen + credentials).
# The app runs fine without these — they're only needed to actually log in.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback
JWT_SECRET=dev-insecure-secret-change-me
